; i2c-soak --- back-to-back combined-format write+read soak at 400 kHz
; against the embassy-imxrt I2C target-trait slave running on rt685s-evk
; at 7-bit address 0x20 (i2c-slave-async-target-trait.rs / FC2).
;
; Companion to OpenDevicePartnership/embassy-imxrt PR #565:
; reproducer for the slv_state -> addressed mid-DMA HW race jerrysxie
; reported. Loops forever, hitting ACK slots with `expect=0 mask=1` on
; every controller-driven byte; on the first NACK / line-stuck-high
; (which is how a wedged slave manifests to the controller) we
; fall through into a JMP to a fail-fast handler that MARKs the
; wedge site and HALTs. The skip-on-ACK is encoded as
; `BRANCH_ON NOT_MISMATCH, 1` --- if the slave ACKed, MISMATCH_FLAG
; is clear, so we skip the wedge JMP and continue. If the slave
; NACKed (line stuck high), MISMATCH_FLAG is set, BRANCH_ON
; NOT_MISMATCH is not taken, and we fall into the wedge JMP. The
; host (mole-loader) drains the ring and returns non-zero; the
; slave-side RTT log identifies whether the slave's own RACE WATCH
; telemetry caught the mis-classification.
;
; Transaction shape (every iteration):
;   START
;   addr+W (0x40)             ; slave at 7-bit 0x20, R/W=0
;   write 8 bytes of 0x55     ; max edge density: SDA toggles every bit-time
;   Sr (repeated START)
;   addr+R (0x41)             ; same slave, R/W=1
;   read  8 bytes             ; controller releases SDA; ACKs bytes 0..6,
;                             ; NACKs byte 7 to terminate
;   STOP
;   STRETCH_SCL_IMM 3         ; tBUF >= 1.3 us (3 quarters = 1.875 us @ 400 kHz)
;
; Note: the slave example overwrites its 8-byte buffer with
; [0,1,2,3,4,5,6,7] at the top of each respond_* iteration, so the
; wire pattern on the read side is that 8-byte sequence repeated.
; Since this program does not capture read bits (no `capture=1` in
; the read body), the wire-side values don't affect the test ---
; we're hunting state-machine race, not byte values.
;
; -------------------------------------------------------------------------
; v0.2 spelling
; -------------------------------------------------------------------------
;
; Loop counters:
;   R5 = outer heartbeat counter (255 transactions per MARK 0xAA);
;        primed with raw `LOAD_IMM R5, 255` since `LOAD_LOOP` sugar
;        only targets R6 in v0.2.
;   R6 = inner byte counter; re-primed via `LOAD_LOOP n` (sugar for
;        `LOAD_IMM R6, n`) for each of the write (8 bytes) and
;        read-with-ACK (7 bytes) loops.
;
; The v0-era fused `DEC_BRANCH lcrN, label` is gone in v0.2 (§5.21
; / §15.2 transition notes). The replacement idiom is the
; hazard-free pair `DEC Rx` + `BRANCH_ON {NOT_REG_ZERO|REG_ZERO},
; label`, consuming the freshly-written REG_ZERO_FLAG. Per §14 the
; back-to-back form is forwarding-immune; the assembler warns
; (LINT-001) if any other ALU op sits between the two.
;
; EMIT_BIT/EMIT_QUARTER/STRETCH_SCL are now suffixed _IMM in v0.2.
; LOAD_TIMING uses positional reg/divider (reg=0 = i2c quarter-bit
; divider per §5.17).
;
; START / STOP / Sr edges doubled (each canonical quarter held for two
; ticks) to match the empirically-validated tmp108.moleasm timing.

.equ fast_div, 14            ; 400 kHz exact at 24 MHz fabric (book divider table)

        LOAD_TIMING   reg=0, divider=fast_div
        SET_BUS_MODE  i2c
        SET_ROLE      controller

loop_reset:
        LOAD_IMM      R5, 255            ; 255 transactions per heartbeat MARK

inner_loop:
        ; -- START: 4 idle + 2 SDA-falls + 2 SCL-down (8 quarters total) --
        EMIT_QUARTER_IMM  sda=recessive scl=recessive
        EMIT_QUARTER_IMM  sda=recessive scl=recessive
        EMIT_QUARTER_IMM  sda=recessive scl=recessive
        EMIT_QUARTER_IMM  sda=recessive scl=recessive
        EMIT_QUARTER_IMM  sda=dominant  scl=recessive
        EMIT_QUARTER_IMM  sda=dominant  scl=recessive
        EMIT_QUARTER_IMM  sda=dominant  scl=dominant
        EMIT_QUARTER_IMM  sda=dominant  scl=dominant

        ; -- addr_w = 0x40 = 0100 0000 (slave at 0x20, R/W=0) --
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=dominant

        ; -- slave ACK + fail-fast --
        EMIT_BIT_IMM  tx=recessive expect=0 mask=1
        BRANCH_ON     NOT_MISMATCH, 1
        JMP           wedge_addr_w

        ; -- 8x write 0x55 (0101 0101, MSB-first) using R6 --
        LOAD_LOOP     8
write_byte_body:
        EMIT_BIT_IMM  tx=dominant       ; bit 7 = 0
        EMIT_BIT_IMM  tx=recessive      ; bit 6 = 1
        EMIT_BIT_IMM  tx=dominant       ; bit 5 = 0
        EMIT_BIT_IMM  tx=recessive      ; bit 4 = 1
        EMIT_BIT_IMM  tx=dominant       ; bit 3 = 0
        EMIT_BIT_IMM  tx=recessive      ; bit 2 = 1
        EMIT_BIT_IMM  tx=dominant       ; bit 1 = 0
        EMIT_BIT_IMM  tx=recessive      ; bit 0 = 1

        EMIT_BIT_IMM  tx=recessive expect=0 mask=1
        BRANCH_ON     NOT_MISMATCH, 1
        JMP           wedge_data_w

        DEC           R6
        BRANCH_ON     NOT_REG_ZERO, write_byte_body

        ; -- Sr (repeated START): 2 SCL-up + 2 SDA-up + 2 SDA-down + 2 SCL-down --
        EMIT_QUARTER_IMM  sda=dominant  scl=dominant
        EMIT_QUARTER_IMM  sda=dominant  scl=dominant
        EMIT_QUARTER_IMM  sda=recessive scl=dominant
        EMIT_QUARTER_IMM  sda=recessive scl=dominant
        EMIT_QUARTER_IMM  sda=recessive scl=recessive
        EMIT_QUARTER_IMM  sda=recessive scl=recessive
        EMIT_QUARTER_IMM  sda=dominant  scl=recessive
        EMIT_QUARTER_IMM  sda=dominant  scl=recessive
        EMIT_QUARTER_IMM  sda=dominant  scl=dominant
        EMIT_QUARTER_IMM  sda=dominant  scl=dominant

        ; -- addr_r = 0x41 = 0100 0001 --
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=dominant
        EMIT_BIT_IMM  tx=recessive

        ; -- slave ACK + fail-fast --
        EMIT_BIT_IMM  tx=recessive expect=0 mask=1
        BRANCH_ON     NOT_MISMATCH, 1
        JMP           wedge_addr_r

        ; -- 7x read with controller ACK (no capture; we're not
        ;    validating bytes, only provoking the race) --
        LOAD_LOOP     7
read_byte_body:
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=dominant            ; controller ACK
        DEC           R6
        BRANCH_ON     NOT_REG_ZERO, read_byte_body

        ; -- 8th (last) read byte: same 8 bits + controller NACK --
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive
        EMIT_BIT_IMM  tx=recessive          ; controller NACK (release for STOP)

        ; -- STOP: SDA rises while SCL high --
        EMIT_QUARTER_IMM  sda=dominant  scl=dominant
        EMIT_QUARTER_IMM  sda=dominant  scl=dominant
        EMIT_QUARTER_IMM  sda=dominant  scl=recessive
        EMIT_QUARTER_IMM  sda=dominant  scl=recessive
        EMIT_QUARTER_IMM  sda=recessive scl=recessive
        EMIT_QUARTER_IMM  sda=recessive scl=recessive

        ; -- tBUF: hold both lines recessive >= 1.3 us before next START --
        STRETCH_SCL_IMM   3

        ; -- back-edge: 254 more iterations before MARK + reset --
        DEC           R5
        BRANCH_ON     NOT_REG_ZERO, inner_loop

        ; -- heartbeat: one MARK per 255 transactions --
        MARK          label=0xAA

        ; -- back to reload R5 and run another 255 transactions --
        JMP           loop_reset

; -------------------------------------------------------------------------
;  Wedge handlers.  Reached via the BRANCH_ON NOT_MISMATCH,+1 / JMP
;  pattern at every ACK slot in the loop body: if the slave ACKed
;  (MISMATCH_FLAG clear), NOT_MISMATCH is true and we branch *over*
;  the JMP; if the slave NACKed (MISMATCH_FLAG set), NOT_MISMATCH is
;  false, we fall through into the JMP, and the JMP gives us full
;  reach to the wedge handler at the bottom of the program (well
;  outside BRANCH_ON's signed 10-bit reach in tight inner loops).
;
;  HALT status discriminates the failure site for the host:
;    1 = NACK on the write-address ACK slot
;    2 = NACK on a write-data ACK slot (any of bytes 0..7)
;    3 = NACK on the read-address ACK slot
;
;  All three are symptomatic of a wedged slave (no one pulling SDA low
;  during the ACK slot). The MARK label mirrors the HALT status for
;  result-ring decode redundancy.
; -------------------------------------------------------------------------

wedge_addr_w:
        MARK          label=1
        HALT          status=1

wedge_data_w:
        MARK          label=2
        HALT          status=2

wedge_addr_r:
        MARK          label=3
        HALT          status=3
