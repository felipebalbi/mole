# iCEbreaker (iCE40 UP5K-SG48) pin assignment for the Mole v0
# bit-cycle engine top (`MoleTop`).
#
# This is a *placeholder* committed alongside the scaffold. Pin
# numbers are taken from the iCEbreaker rev 1.x silkscreen and are
# stable; what may still move as MoleTop's IO settles is which
# debug / status LEDs we expose and whether SDA/SCL move to a
# different PMOD slot.

# 12 MHz on-board oscillator
set_io io_clk        35
set_frequency io_clk 12

# Active-low reset (iCEbreaker user button: pulled high externally,
# shorted to ground when pressed).
set_io io_reset      10

# USB-UART (FT2232H channel A → /dev/ttyUSB0). Mole loads programs
# in and streams results out over this link.
#   io_uRx receives from the host (program bytes).
#   io_uTx transmits to the host  (result-ring bytes).
set_io io_uRx         6
set_io io_uTx         9

# USB-UART hardware flow control (FT2232H channel A, active-low).
#
# Naming follows the FT2232H's pin labels, which match what shows
# up on the iCEbreaker silkscreen:
#
#   io_uCts (pin 18, MOLE OUTPUT) -> FT2232H CTS# input. We drive
#       this LOW when Mole is ready to receive a new program (i.e.
#       the top-level phase FSM is in `acceptLoadState`) and HIGH
#       while a program is running or the result ring is draining.
#       A host driver with `crtscts` enabled will block its TX
#       (program-to-Mole direction) on this line, which is exactly
#       what the user spec asks for: "while program is not HALTED,
#       don't accept data."
#
#   io_uRts (pin 19, MOLE INPUT)  <- FT2232H RTS# output. We sample
#       this through the same 2-FF synchronizer pattern as `io_uRx`
#       and use it to back-pressure the drainer's TX stream. When
#       the host's USB pipe is full it asserts RTS# HIGH and Mole's
#       drainer halts via `Stream.haltWhen`; when the host can take
#       more bytes RTS# drops LOW and the drainer streams again.
#       Standard hardware-flow-control semantics: deassertion does
#       not abort an in-flight byte, only future starts.
#
# Pull-up on the RTS# input: if a board does not wire FT's RTS#
# through to FPGA pin 19 (or stty is invoked without `crtscts`),
# the pin floats. Without a pull-up the synchroniser samples
# garbage and the drainer's behaviour becomes "sometimes streams,
# sometimes hangs". With `-pullup yes`, an unwired pin reads HIGH
# = RTS#-deasserted = drainer halts visibly, which is a clean,
# diagnosable failure mode (BRINGUP.md §troubleshooting documents
# the symptom -> cause mapping). The CTS# output does not need a
# pull-up; it is driven by Mole at all times.
set_io io_uCts        18
set_io -pullup yes io_uRts 19

# I3C / I2C bus, brought out on PMOD1A. The pad layer is an explicit
# SB_IO per line (see src/hw/MoleIoBufUp5k.scala) with PIN_TYPE
# 6'b101000 (PIN_OUTPUT_TRISTATE | PIN_INPUT, unregistered): the
# wrapper drives OUTPUT_ENABLE := driveLow || driveHigh and
# D_OUT_0   := driveHigh, so the pad can sit in three states under
# program control:
#   - driveLow  -> NMOS pulls the line to GND (I2C / I3C-OD low)
#   - driveHigh -> PMOS drives the line to VIO (I3C-PP / HDR-DDR high)
#   - both off  -> output tristated; external pull-up wins (OD release)
#
# External pull-ups on the PMOD adapter (4.7 kΩ for I2C, ~1 kΩ for
# the I3C-OD windows that need it) are still required: OD-class
# BUS_MODEs decode "recessive" as both drivers off, and the line
# must rise to VIO without a PP drive in those modes. The pad CAN
# drive actively high; the symbol decoder (src/hw/BusMode.scala) is
# what gates that to PP-class BUS_MODEs only.
#
# PMOD1A pin map (iCEbreaker rev 1.x):
#   PMOD1A.1 (FPGA pin 4) → io_scl
#   PMOD1A.2 (FPGA pin 2) → io_sda
#
# Wire 4.7 kΩ pull-ups (or 1 kΩ for I3C push-pull-ish operation
# during pre-DAA windows) from each line to 3.3 V.
set_io io_scl         4
set_io io_sda         2

# Status LEDs (iCEbreaker rev 1.x on-board). Named by FUNCTION,
# not color, because the iCEbreaker's silkscreen / package labels
# disagree with the physically populated LED colors on this board
# revision:
#
#   io_ledFault     -> pin 11 (silkscreen LEDR; physically a small
#                      red 0603 SMD LED). Active-low. Drive LOW =
#                      pin LOW = LED ON. Lit on loader fault
#                      (bad CRC / bad MAGIC / bad LEN / UART RX
#                      error mid-frame) OR sticky CTS#-violation
#                      observation. Pulse-stretched ~175 ms so a
#                      one-cycle fault is visible to the eye.
#   io_ledRunning   -> pin 37 (silkscreen LEDG; physically a small
#                      green 0603 SMD LED). Active-low. Lit while
#                      `engineStarted && !pipeline.halted` --- i.e.
#                      the engine is currently executing program
#                      instructions. Goes off the moment HALT
#                      commits.
#   io_ledHeartbeat -> pin 40 (silkscreen LED_RGB1; iCEbreaker
#                      docs call this the "green channel" of the
#                      big on-board RGB LED, but the physically
#                      populated big LED on this rev lights GREEN
#                      from this pin --- the silkscreen naming is
#                      misleading). Active-low. Drives a 26-bit
#                      counter's MSB AND'd with `halted ||
#                      !engineStarted`, so it blinks at ~1.4 s on
#                      / 1.4 s off WHILE THE ENGINE IS IDLE
#                      (acceptLoad waiting for a frame, or just
#                      halted) and STOPS the moment the engine
#                      starts running.
#
# Functional naming survives a future board respin that swaps
# physical LED colors. The previous naming (io_ledR / io_ledG /
# io_ledB) was based on the iCEbreaker silkscreen and led to
# real bench-debug confusion when a "blue heartbeat" turned out
# to be a green LED.
set_io io_ledFault     11
set_io io_ledRunning   37
set_io io_ledHeartbeat 40
