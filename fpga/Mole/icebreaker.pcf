# iCEbreaker (iCE40 UP5K-SG48) pin assignment for the Mole v0
# bit-cycle engine top (`MoleTop`).
#
# This is a *placeholder* committed alongside the scaffold. Pin
# numbers are taken from the iCEbreaker rev 1.x silkscreen and are
# stable; what may still move as MoleTop's IO settles is which
# debug / status LEDs we expose and whether SDA/SCL move to a
# different PMOD slot.

# 12 MHz on-board oscillator
set_io io_clk        35
set_frequency io_clk 12

# Active-low reset (iCEbreaker user button: pulled high externally,
# shorted to ground when pressed).
set_io io_reset      10

# USB-UART (FT2232H channel A → /dev/ttyUSB0). Mole loads programs
# in and streams results out over this link.
#   io_uRx receives from the host (program bytes).
#   io_uTx transmits to the host  (result-ring bytes).
set_io io_uRx         6
set_io io_uTx         9

# I3C / I2C bus, brought out on PMOD1A. The pad layer is an explicit
# SB_IO per line (see src/hw/MoleIoBufUp5k.scala) with PIN_TYPE
# 6'b101000 (PIN_OUTPUT_TRISTATE | PIN_INPUT, unregistered): the
# wrapper drives OUTPUT_ENABLE := driveLow || driveHigh and
# D_OUT_0   := driveHigh, so the pad can sit in three states under
# program control:
#   - driveLow  -> NMOS pulls the line to GND (I2C / I3C-OD low)
#   - driveHigh -> PMOS drives the line to VIO (I3C-PP / HDR-DDR high)
#   - both off  -> output tristated; external pull-up wins (OD release)
#
# External pull-ups on the PMOD adapter (4.7 kΩ for I2C, ~1 kΩ for
# the I3C-OD windows that need it) are still required: OD-class
# BUS_MODEs decode "recessive" as both drivers off, and the line
# must rise to VIO without a PP drive in those modes. The pad CAN
# drive actively high; the symbol decoder (src/hw/BusMode.scala) is
# what gates that to PP-class BUS_MODEs only.
#
# PMOD1A pin map (iCEbreaker rev 1.x):
#   PMOD1A.1 (FPGA pin 4) → io_scl
#   PMOD1A.2 (FPGA pin 2) → io_sda
#
# Wire 4.7 kΩ pull-ups (or 1 kΩ for I3C push-pull-ish operation
# during pre-DAA windows) from each line to 3.3 V.
set_io io_scl         4
set_io io_sda         2

# Status LEDs (iCEbreaker on-board). Used for engine state /
# heartbeat / HALT-status indication.
set_io io_ledR       11
set_io io_ledG       37
set_io io_ledB       40
