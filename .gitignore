# =============================================================================
# Mole --- .gitignore
# Covers: Rust, SpinalHDL (Scala + SBT/Mill), iCE40/ECP5 FPGA toolchain
# (yosys/nextpnr/icestorm/prjtrellis), simulation outputs, editors, OS noise.
# =============================================================================

# -----------------------------------------------------------------------------
# Rust
# -----------------------------------------------------------------------------
target/
**/*.rs.bk

# We DO commit Cargo.lock at the workspace root --- this project ships binaries
# (compiler, host tools), so reproducible builds matter. Library-only crates
# inside the workspace inherit the root lock; do not add per-crate locks.
#Cargo.lock

# rustc / cargo incremental + profiling
*.profraw
*.profdata
flamegraph.svg
perf.data
perf.data.old

# rust-analyzer
.rust-analyzer/

# -----------------------------------------------------------------------------
# SpinalHDL / Scala / SBT / Mill
# -----------------------------------------------------------------------------
# SBT
project/target/
project/project/
project/build.properties.lock
.bsp/
.metals/
.bloop/
.ammonite/
.scala-build/

# Mill
out/

# Compiled Scala / JVM
*.class
*.jar
*.war

# SpinalHDL default sim workspaces
simWorkspace/
simWorkspaceShared/

# -----------------------------------------------------------------------------
# FPGA toolchain artifacts (yosys / nextpnr / icestorm / prjtrellis)
# -----------------------------------------------------------------------------
# Bitstreams and intermediate binaries
*.asc
*.bin
*.bit
*.svf
*.fasm
*.frames
*.config
*.bitsize

# Synthesis / PnR reports + logs
*.rpt
*.log
yosys.log
nextpnr.log
*.timing.rpt

# Generated Verilog/VHDL from SpinalHDL: leave UNIGNORED by default
# so any sub-project can choose to commit a reference snapshot. The
# Mole top-level (fpga/Mole/) does NOT commit its generated Verilog
# --- regenerate via `make gen`.
fpga/Mole/gen/

# -----------------------------------------------------------------------------
# Simulation
# -----------------------------------------------------------------------------
# Verilator
obj_dir/
*.vcd
*.fst
*.ghw
*.wlf
*.shm/

# cocotb / pytest sim
sim_build/
results.xml
__pycache__/

# -----------------------------------------------------------------------------
# Generated bytecode / test artifacts
# -----------------------------------------------------------------------------
# Compiled .lisp -> .mole bytecode binaries
*.mole.bin
*.mole.hex
# Result-ring dumps from real-hardware runs
*.results.bin
captures/

# -----------------------------------------------------------------------------
# Python glue (compiler harness, regression scripts, sensor-emulator gen)
# -----------------------------------------------------------------------------
*.py[cod]
*$py.class
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Generic build / dist
# -----------------------------------------------------------------------------
build/
dist/
*.egg-info/

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.code-workspace

# Emacs
*~
\#*\#
.\#*
TAGS

# Vim
*.sw[a-p]

# JetBrains misc
.fleet/

# -----------------------------------------------------------------------------
# OS noise
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Local environment / direnv / nix shells
# -----------------------------------------------------------------------------
.direnv/
.envrc.local
result
result-*

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.bak
*.orig
*.tmp
.cache/
